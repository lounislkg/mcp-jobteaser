# Required in production: token Claude must send as `Authorization: Bearer <token>`.
# Without it the server logs a warning and accepts unauthenticated requests.
MCP_AUTH_TOKEN=

MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# Only needed outside Docker, e.g. running natively on a Raspberry Pi with
# `apt install chromium` instead of Playwright's bundled browser.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# CHROMIUM_EXTRA_ARGS=--no-sandbox,--disable-dev-shm-usage

# JOBTEASER_PAGE_DELAY_SECONDS=1.5
